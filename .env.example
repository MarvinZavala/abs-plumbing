# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.

# Public site URL, used for canonical URLs, the sitemap and structured data.
# On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# --- Estimate form delivery (set at least one, or the form tells visitors to call) ---

# Email through Resend (https://resend.com, free tier is plenty).
# With the default sender (onboarding@resend.dev) Resend only delivers to the address the
# Resend account was created with, so create the account with the inbox that should get leads,
# or verify the business domain in Resend and set LEAD_FROM_EMAIL to an address on it.
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@abs-plumbing.com
LEAD_FROM_EMAIL=

# Any URL that accepts a JSON POST: Zapier, Make, a Google Sheets script, a CRM, an SMS service...
# Use it together with email so a lead still arrives if one channel fails.
LEAD_WEBHOOK_URL=

# --- Google tags: use Google Tag Manager OR the direct IDs below, not both ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA_ID=

# Google Ads conversion labels (the part after the slash in send_to: 'AW-123456789/AbCdEfGh').
# call_click and text_click fire when someone taps a call or text button; lead_submit when the form succeeds.
NEXT_PUBLIC_ADS_LABEL_CALL=
NEXT_PUBLIC_ADS_LABEL_TEXT=
NEXT_PUBLIC_ADS_LABEL_LEAD=

# --- Search engine verification (paste the token only, not the whole meta tag) ---
# Google Search Console > Add property > URL prefix > HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01). Or import the site from Search Console.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
